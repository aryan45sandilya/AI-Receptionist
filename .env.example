# ---------------------------------------------------------------------------
# Copy to .env and fill in. .env is gitignored; this file is committed.
# ---------------------------------------------------------------------------

# --- Postgres (Supabase) ---------------------------------------------------
# Supabase dashboard -> Connect -> "Direct / Connection string" tab -> copy the
# SESSION POOLER string (port 5432), then make two edits:
#
#   1. postgresql://  ->  postgresql+psycopg://
#      Supabase hands you the plain scheme; without +psycopg, SQLAlchemy picks
#      a driver that is not installed.
#
#   2. Replace [YOUR-PASSWORD] with the database password.
#      If it contains @ : / ? # or %, percent-encode it -- an unencoded @ makes
#      the URL parse as a different hostname, and the error does not say so.
#
# Use the Session pooler (5432), not "Direct connection" (IPv6-only without the
# paid IPv4 add-on, so it fails on most home networks). The Transaction pooler
# (6543) also works -- the code detects that port and turns prepared statements
# off automatically -- but it is slightly slower per query.
DATABASE_URL=postgresql+psycopg://postgres.PROJECTREF:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# --- LLM (Groq) ------------------------------------------------------------
# Free key, no card: https://console.groq.com/keys
# Groq is used for latency -- on a phone call, time to first word is the whole
# experience. The endpoint is OpenAI-compatible, so pointing LLM_BASE_URL at
# another provider is a config change, not a code change.
LLM_API_KEY=gsk_...
LLM_BASE_URL=https://api.groq.com/openai/v1

# gpt-oss-120b is the most capable chat model on Groq's free tier. The Llama 3.x
# models are Enterprise-only and return 404 on a free key. Smaller free
# alternatives worth benchmarking in Phase 6: openai/gpt-oss-20b, qwen/qwen3.8-27b.
# To see what your key can actually use: python -m scripts.list_models
LLM_MODEL=openai/gpt-oss-120b
LLM_MAX_TOKENS=1024
# gpt-oss "thinks" before speaking. low cuts time to first word roughly 3x.
# Leave empty for models that do not accept the parameter.
LLM_REASONING_EFFORT=low
# Low but not zero: predictable, without sounding like a recording.
LLM_TEMPERATURE=0.3

# --- Speech ----------------------------------------------------------------
# Which service transcribes the caller and which speaks for the agent. "auto"
# uses Deepgram when DEEPGRAM_API_KEY is set and Groq otherwise, so a clone with
# only a free Groq key still works. Name one to force it.
#   deepgram  streaming over WebSockets: the transcript is ready ~0.5 s sooner,
#             speech starts after the first chunk, no daily request cap
#   groq      batch Whisper and Orpheus: free, but Orpheus allows only ~100
#             requests a day, which a few phone calls will use up
STT_PROVIDER=auto
TTS_PROVIDER=auto

# Deepgram: free signup credit, no card. https://console.deepgram.com
DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODEL=nova-3
# Silence, in ms, before Deepgram calls an utterance finished. Lower answers
# sooner but cuts off callers who pause mid-sentence.
DEEPGRAM_ENDPOINTING_MS=400
# The local silence timer. With Groq it is what ends every utterance (800 ms);
# with Deepgram it is only a backstop, so it waits longer (1500 ms).
VAD_END_SILENCE_MS=800
VAD_BACKSTOP_MS=1500
# python -m scripts.list_voices lists the options.
DEEPGRAM_TTS_MODEL=aura-2-cordelia-en

# Groq (same key as the LLM above)
STT_MODEL=whisper-large-v3-turbo
# Pinned rather than auto-detected: callers mix English and Tamil mid-sentence
# and auto-detect can silently translate a whole utterance.
STT_LANGUAGE=en
# Orpheus needs its terms accepted once per Groq organisation:
#   https://console.groq.com/playground?model=canopylabs%2Forpheus-v1-english
TTS_MODEL=canopylabs/orpheus-v1-english
# autumn, diana, hannah, austin, daniel, troy
TTS_VOICE=hannah

# --- Barge-in ----------------------------------------------------------------
# The caller can talk over the agent and it stops. Set to false if speakers feed
# the agent's own voice back into the microphone and it keeps interrupting itself
# (headphones fix this properly).
BARGE_IN=true
# How long the caller must keep talking before it counts as an interruption.
BARGE_IN_MS=300

# --- Phone calls (Twilio) -----------------------------------------------------
# Free trial, no card: https://www.twilio.com/try-twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The Twilio number calls are placed from / received on, in E.164 form.
TWILIO_PHONE_NUMBER=
# The https address Twilio reaches this server on. For development, a free
# tunnel:  cloudflared tunnel --url http://localhost:8000
# Used to check webhook signatures, so it must match what Twilio is calling.
# For calls TO your number, also set the number's voice webhook (HTTP POST) in the
# Twilio console to <this address>/twilio/voice. Calls the project places itself
# (python -m scripts.twilio_call) name that URL on their own.
PUBLIC_BASE_URL=

# --- Later phases (unused so far) ---------------------------------------------
CARTESIA_API_KEY=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
REDIS_URL=redis://localhost:6379/0
