# ---------------------------------------------------------------------------
# Copy to .env and fill in. .env is gitignored; this file is committed.
# ---------------------------------------------------------------------------

# --- Postgres (Supabase) ---------------------------------------------------
# Supabase dashboard -> Connect -> "Direct / Connection string" tab -> copy the
# SESSION POOLER string (port 5432), then make two edits:
#
#   1. postgresql://  ->  postgresql+psycopg://
#      Supabase hands you the plain scheme; without +psycopg, SQLAlchemy picks
#      a driver that is not installed.
#
#   2. Replace [YOUR-PASSWORD] with the database password.
#      If it contains @ : / ? # or %, percent-encode it -- an unencoded @ makes
#      the URL parse as a different hostname, and the error does not say so.
#
# Use the Session pooler (5432), not "Direct connection" (IPv6-only without the
# paid IPv4 add-on, so it fails on most home networks). The Transaction pooler
# (6543) also works -- the code detects that port and turns prepared statements
# off automatically -- but it is slightly slower per query.
DATABASE_URL=postgresql+psycopg://postgres.PROJECTREF:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# --- LLM (Groq) ------------------------------------------------------------
# Free key, no card: https://console.groq.com/keys
# Groq is used for latency -- on a phone call, time to first word is the whole
# experience. The endpoint is OpenAI-compatible, so pointing LLM_BASE_URL at
# another provider is a config change, not a code change.
LLM_API_KEY=gsk_...
LLM_BASE_URL=https://api.groq.com/openai/v1

# gpt-oss-120b is the most capable chat model on Groq's free tier. The Llama 3.x
# models are Enterprise-only and return 404 on a free key. Smaller free
# alternatives worth benchmarking in Phase 6: openai/gpt-oss-20b, qwen/qwen3.8-27b.
# To see what your key can actually use: python -m scripts.list_models
LLM_MODEL=openai/gpt-oss-120b
LLM_MAX_TOKENS=1024
# gpt-oss "thinks" before speaking. low cuts time to first word roughly 3x.
# Leave empty for models that do not accept the parameter.
LLM_REASONING_EFFORT=low
# Low but not zero: predictable, without sounding like a recording.
LLM_TEMPERATURE=0.3

# --- Speech (same Groq key) ------------------------------------------------
STT_MODEL=whisper-large-v3-turbo
# Pinned rather than auto-detected: callers mix English and Tamil mid-sentence
# and auto-detect can silently translate a whole utterance.
STT_LANGUAGE=en
# Orpheus needs its terms accepted once per Groq organisation:
#   https://console.groq.com/playground?model=canopylabs%2Forpheus-v1-english
TTS_MODEL=canopylabs/orpheus-v1-english
# autumn, diana, hannah, austin, daniel, troy
TTS_VOICE=hannah

# --- Phase 3+ (unused so far) ----------------------------------------------
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
REDIS_URL=redis://localhost:6379/0
